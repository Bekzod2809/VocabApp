# Serverda /opt/vocabapp/deploy/.env sifatida turadi (GitHub'ga yuklanmaydi).
# Birinchi o'rnatishda server-setup.sh o'zi tasodifiy qiymatlar bilan yaratadi.

# PostgreSQL paroli (faqat Docker ichida ishlatiladi)
POSTGRES_PASSWORD=change-me

# JWT imzo kaliti: kamida 32 belgi. Yaratish: openssl rand -base64 48
# O'zgartirilsa, hamma qurilmalardan qaytadan kirish kerak bo'ladi.
JWT_SECURITY_KEY=change-me-to-a-long-random-string
